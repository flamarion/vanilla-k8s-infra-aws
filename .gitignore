# =============================================================================
# Terraform
# =============================================================================
# Local cache (downloaded providers + modules)
.terraform/
.terraform.lock.hcl

# State and backups (use a remote backend for shared state)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Plan output and generated files
*.tfplan
*.tfplan.*
*.out

# Per-environment variables (contain secrets / per-deploy values).
# Keep `terraform.tfvars.example` as the canonical template.
*.tfvars
!*.tfvars.example

# CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =============================================================================
# Ansible
# =============================================================================
# Fact cache (regenerated on each run)
.ansible_fact_cache/
*/.ansible_fact_cache/

# Retry files
*.retry

# Generated kubeconfig (fetched from controllers[0] on init)
ansible/kubeconfig

# Vault password files
.vault_pass
.vault_password
vault_password*

# =============================================================================
# Secrets / SSH keys
# =============================================================================
# Project-default SSH keypair name. Public key (.pub) is safe to commit;
# private key must never be.
deployment
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa

# Generic credential files
.env
.env.*
!.env.example
credentials
credentials.json
*.secret

# =============================================================================
# Python (Ansible runtime)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# =============================================================================
# Editors / IDEs
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# =============================================================================
# OS
# =============================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# Project-specific
# =============================================================================
# Local notes / scratchpads
NOTES.md
TODO.local.md
.claude/
